# Leave empty in development to use the Vite proxy to http://localhost:5000.
# In production set the full API origin, e.g. https://api.example.com
VITE_API_URL=

# Stripe test publishable key (pk_test_...). Safe to expose; never put a secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Shows seeded demo accounts on the login page. Set false for a public deployment.
VITE_SHOW_DEMO_ACCOUNTS=true
