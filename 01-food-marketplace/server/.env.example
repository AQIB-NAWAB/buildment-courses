# Core runtime
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB must be a replica set for transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/freshmarket?replicaSet=rs0&directConnection=true

# Redis powers the catalogue cache, coupon throttling, and BullMQ.
REDIS_URL=redis://127.0.0.1:6379

# Auth — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set true for curl/API clients that cannot use the httpOnly refresh cookie.
RETURN_REFRESH_TOKEN=false
COOKIE_SECURE=false

# Money
CURRENCY=inr

# Stripe test mode only. Never use sk_live_ here.
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:5000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Cloudinary — required for vendor product photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inventory and cache
RESERVATION_TTL_MINUTES=15
CATALOGUE_CACHE_TTL_SECONDS=300

# Optional: allow the seed script to run when NODE_ENV=production.
ALLOW_SEED=false
